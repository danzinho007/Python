# Arquivo: gerar_testes_manifest.py
import os

# Caminho do arquivo com os ManifestIDs
entrada = r"C:\Users\Daniel\Documents\PC- Notas\comandos_steamcmd.txt"

# Caminho para salvar o arquivo .bat do SteamCMD
saida = r"C:\Users\Daniel\Documents\PC- Notas\teste_manifest.bat"

# AppID e DepotID
app_id = "65800"
depot_id = "65801"

# Caminho do SteamCMD
steamcmd_path = r"D:\PS4\steamcmd\steamcmd.exe"  # ajuste para onde está o seu steamcmd

with open(entrada, "r") as f:
    gids = [line.strip() for line in f if line.strip()]

with open(saida, "w") as f:
    f.write(f'@echo off\n')
    f.write(f'{steamcmd_path} +login anonymous\n')  # ou seu login
    for gid in gids:
        f.write(f'{steamcmd_path} +login anonymous +download_depot {app_id} {depot_id} {gid} +quit\n')
    f.write('pause\n')

print(f"Arquivo de teste criado em: {saida}")
